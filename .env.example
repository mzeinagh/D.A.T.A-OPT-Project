# Copy this file to .env and fill in real values locally. Never commit .env.
#
# manage.py defaults DJANGO_SETTINGS_MODULE to dataopt.settings.dev; set it
# explicitly to dataopt.settings.prod for a production deployment (which
# also requires DJANGO_SECRET_KEY and DJANGO_ALLOWED_HOSTS to be set — it
# refuses to start otherwise).

# ---------------------------------------------------------------- Django
DJANGO_SETTINGS_MODULE=dataopt.settings.dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------- PostgreSQL
# PostgreSQL is the authoritative store — no permanent transcript files.
POSTGRES_DB=data_opt
POSTGRES_USER=data_opt
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------- Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---------------------------------------------------------------- core_pipeline
# Local sentence-transformers model directory (all-MiniLM-L6-v2) and the
# evaluator's handbook PDF. Machine-specific — never hardcode these in code,
# set them here instead. Defaults (in dataopt/settings/base.py) point at the
# repo's own embeddings_local/ and dependants/ folders, which is fine for a
# single-machine dev setup but should be overridden for anything else.
EMBEDDING_MODEL_PATH=
HANDBOOK_PDF_PATH=

# ---------------------------------------------------------------- OCR (Docling)
OCR_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- Corpus detection retry
CORPUS_DETECTION_MAX_RETRIES=3

# ---------------------------------------------------------------- OpenAI / GPT-5
# All three LLM call sites (retrieve_guide, generate, formatter) run through
# this configuration — nothing above is hardcoded in llm/ or core_pipeline/.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_MAX_OUTPUT_TOKENS=1024
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3

# Optional per-run cost ceiling. Disabled by default until real benchmark
# data exists (see migration plan, decision 2) — setting only the limit
# without enabling it is a no-op.
OPENAI_COST_LIMIT_ENABLED=false
OPENAI_COST_LIMIT_USD=
